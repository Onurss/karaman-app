# ============================================================
# Karaman.com — Ortam Değişkenleri Şablonu
# Her uygulamanın kendi .env.local'i olmalı.
# Public prefix'li değişkenler mobile/web bundle'a dahil edilir.
# ============================================================

# --- Mobile (Expo) ---
EXPO_PUBLIC_KARAMAN_API_URL=https://karaman.com/api/v1
EXPO_PUBLIC_KARAMAN_API_KEY=karaman_app_secret_key_2026_REPLACE
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...REPLACE
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...REPLACE
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_SENTRY_DSN=https://....ingest.sentry.io/...
EXPO_PUBLIC_USE_MOCKS=true

# --- Admin & Restaurant Panel (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...REPLACE
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...REPLACE
NEXT_PUBLIC_SENTRY_DSN=https://....ingest.sentry.io/...

# --- Supabase (server-side, Edge Functions) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...REPLACE
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# --- Ödeme (iyzico) ---
IYZICO_API_KEY=REPLACE
IYZICO_SECRET_KEY=REPLACE
IYZICO_BASE_URL=https://api.iyzipay.com

# --- Ödeme (Garanti Sanal POS) ---
GARANTI_MERCHANT_ID=REPLACE
GARANTI_TERMINAL_ID=REPLACE
GARANTI_PROV_USER=REPLACE
GARANTI_PROV_PASSWORD=REPLACE
GARANTI_STORE_KEY=REPLACE
GARANTI_BASE_URL=https://sanalposprovtest.garantibbva.com.tr

# --- Firebase (push + analytics) ---
FCM_SERVER_KEY=REPLACE
FIREBASE_PROJECT_ID=karaman-app

# --- Public URL (callback'ler için) ---
PUBLIC_URL=https://xxxxxxxxxxxx.supabase.co
