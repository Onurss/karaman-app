# Expo / React Native + pnpm uyumluluğu için kritik ayarlar.
# Metro bundler, expo CLI ve native CocoaPods, pnpm'in symlink yapısını anlamaz.
# node-linker=hoisted: node_modules'ı klasik npm gibi düz yapıda kurar — tüm
# transitive dependency'lere doğrudan erişilebilir, "Unable to resolve module"
# hataları kaybolur.

node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
